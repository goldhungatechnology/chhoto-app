# Chhoto backend environment template
# Copy to env/.env.production (or env/.env.<environment>) and fill in real values.
# The app refuses to boot in production with placeholder secrets.

# Core
ENVIRONMENT=production
APP_URL=https://api.chhoto.tech
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/chhoto_db

# CORS & Frontend
FRONTEND_URL=https://app.chhoto.tech
ALLOWED_ORIGIN_DOMAIN=chhoto.tech
COOKIE_DOMAIN=.chhoto.tech
TRUST_PROXY_HEADERS=true

# Redis
REDIS_URL=redis://redis:6379/0

# Email (SMTP provider by default; set RESEND_API_KEY to switch to Resend)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=2525
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=no-reply@chhoto.tech
RESEND_API_KEY=

# File storage (cloudinary or s3)
UPLOAD_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=chhoto

AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_FOLDER=chhoto
AWS_S3_ENDPOINT_URL=
AWS_S3_PUBLIC_BASE_URL=

# GeoIP (optional MaxMind GeoLite2-City database)
GEOIP_ENABLED=false
GEOIP_DB_PATH=

# Captcha
CAPTCHA_PROVIDER=turnstile
TURNSTILE_SECRET_KEY=

# Misc
ALLOWED_USER_EMAIL=
ENABLE_CAPTCHA=true
